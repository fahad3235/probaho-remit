# =====================================================================
# PROBAHO REMIT — PRODUCTION CONFIGURATION TEMPLATE
# Fill in your secrets and Supabase keys below.
# NEVER commit .env to public repositories or expose keys in client code!
# =====================================================================

# Environment (staging | production)
NODE_ENV=staging
PORT=3000

# Backend: Supabase
SUPABASE_URL=https://[YOUR_SUPABASE_URL].supabase.co
SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SUPABASE_SERVICE_ROLE_KEY]

# Company & Compliance
COMPANY_LEGAL_NAME=Probaho Remit Ltd.
LICENCE_STATUS=Licensed Money Transmitter Partner / Pending BB Approval
SUPPORT_CONTACT=+880 1700-000000 / support@probaho.com
LEGAL_COUNSEL=TBD

# Transaction Limits (BDT)
BASIC_KYC_DAILY_LIMIT=50000
FULL_KYC_DAILY_LIMIT=500000

# Payment Gateways (Sandbox / Production)
CARD_PSP=Stripe Sandbox
BD_GATEWAY=SSLCommerz Sandbox
PAYOUT_PROVIDER=bKash Direct / City Bank Remittance
SCREENING_PROVIDER=ComplyAdvantage Sandbox
